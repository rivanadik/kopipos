# ---- Kasir POS: pengaturan Apache ----
Options -Indexes
DirectoryIndex index.php

# Blokir akses langsung ke file sensitif
<FilesMatch "^(config\.php|database\.sql|README\.md|\.env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

